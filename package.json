{
  "name": "zync-pm2-monitor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A server-bound PM2 workspace for Zync Manifest v2",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "test:ui": "playwright test",
    "test:states": "playwright test --config tests/browser/bundle.config.js",
    "preview": "node scripts/preview.mjs",
    "package": "npm run check && node scripts/package.mjs",
    "release:stage": "node scripts/release.mjs stage",
    "release:verify": "node scripts/release.mjs verify",
    "format": "prettier --write src scripts tests docs *.json *.js *.md",
    "format:check": "prettier --check src scripts tests docs *.json *.js *.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@zync-sh/plugin-sdk": "2.1.0-beta.1",
    "@zync-sh/plugin-ui": "0.1.0-beta.1",
    "esbuild": "^0.25.0",
    "fflate": "0.8.3",
    "prettier": "3.9.9"
  }
}
